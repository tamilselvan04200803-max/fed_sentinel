{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Open FedSentinel in Browser (Edge/Chrome)",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "FastAPI Backend (Uvicorn Debugger)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["main:app", "--reload", "--host", "127.0.0.1", "--port", "8000"]
    }
  ]
}
